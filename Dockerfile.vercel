# Demo image for Vercel: runs the full app (API + built UI) as one container.
# Vercel containers have no persistent disk, so the SQLite file lives in /tmp
# and is reset whenever the instance restarts or scales to zero.
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:24-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4310 DATABASE_PATH=/tmp/alfred.sqlite
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/dist ./dist
USER node
EXPOSE 4310
CMD ["node", "dist/server/server/index.js"]
